{
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(git fetch *)",
      "Bash(source .venv/bin/activate)",
      "Bash(.venv/bin/pytest)",
      "Bash(brew services list*)",
      "Bash(docker info *)",
      "Bash(git grep *)",
      "Bash(gh run watch *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/ops/pool-copy-guard.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ops/public_guard.py\" hook gh || true",
            "timeout": 20
          },
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ops/public_guard.py\" hook git || true",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
