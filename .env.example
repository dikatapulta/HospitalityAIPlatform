# Локальная среда (Task 0004). Скопировать в .env — `make dev` делает это автоматически.
# Секреты в репозитории не хранятся (FOUNDATION §11); .env — в .gitignore.
POSTGRES_USER=hospitality
POSTGRES_PASSWORD=hospitality
POSTGRES_DB=hospitality
POSTGRES_PORT=5432

REDIS_PORT=6379

APP_PORT=8000

# Внешний адрес этой инсталляции (issue #65: постоянный вход через Cloudflare).
# Приложение собирает из него АБСОЛЮТНУЮ ссылку на политику конфиденциальности
# (/legal/privacy) для текста согласия гостя (spec 0029 §2) — в Telegram
# относительная ссылка бессмысленна. На staging/проде обязателен реальный адрес.
PUBLIC_BASE_URL=http://localhost:8000

# Аутентификация HTTP API (Task 0013, FOUNDATION §11): статический сервисный
# токен Phase 0. Запрос к /api/v1/* обязан нести заголовок
# `Authorization: Bearer <SERVICE_TOKEN>`; токен привязан к тенанту по slug.
SERVICE_TOKEN=dev-service-token
SERVICE_TOKEN_TENANT_SLUG=demo-hotel

# AI Gateway (Task 0014, FOUNDATION §7.2): ключ Anthropic (пустой — валидно
# для локальной разработки и тестов: они ходят в MockLlmProvider), модель
# (одна, без маршрутизации), таймаут одного вызова (сек), число попыток
# (ретрай только по таймауту) и дневной бюджет LLM на тенанта в USD
# (UTC-сутки; превышение — отказ ERR-AI-002).
ANTHROPIC_API_KEY=
# Модель гостевого диалога. Sonnet 5 по ADR-012: bake-off (ADR-010) выбирал
# Haiku 4.5 как равный по качеству, но живая проверка staging показала срыв Haiku
# в русский на казахском (#60/#61) — на рынке РК это блокер. ADR-012 переопределяет
# выбор для гостевого диалога; staging уже дефолтит на claude-sonnet-5.
# Значение обязано быть ключом прайс-листа MODEL_PRICING_USD_PER_MTOK
# (src/hospitality/ai/gateway/service.py) — id без даты; иначе процесс не
# стартует с ошибкой конфигурации (issue #137).
LLM_MODEL=claude-sonnet-5
LLM_TIMEOUT_SECONDS=30.0
# Число попыток вызова провайдера, минимум 1 (issue #273): при нуле попыток
# ход гостя падал бы 500-кой вместо кода каталога, поэтому граница стоит на
# конфигурации — с нулём процесс не поднимается вовсе.
LLM_MAX_ATTEMPTS=3
# База экспоненты паузы между попытками после таймаута (issue #46, ADR-017):
# пауза = база × 2^(попытка−1) с разбросом [0.5×, 1×], потолок — один
# LLM_TIMEOUT_SECONDS. При трёх попытках это ~1 с и ~2 с сверх таймаутов; 0
# отключает паузу и возвращает прежнее «три выстрела подряд» по лежащему
# провайдеру. Формула — канон доставки outbox (ADR-009).
LLM_RETRY_BACKOFF_BASE_SECONDS=1.0
# Дневной потолок расхода на тенанта. $10 под объём пилотного отеля (issue #125):
# оценка ~50–100 диалогов в сутки по 4–8 ходов на Sonnet 5 — это $1,2–4,8/день,
# прежние $5 упирались в верх оценки. Это потолок, а не план траты; приближение
# к нему видно заранее — алерт ERR-OPS-006 (ALERT_LLM_BUDGET_RATIO ниже).
LLM_TENANT_DAILY_BUDGET_USD=10.0

# Rate-limit гостевого чата (issue #41, spec 0023, FOUNDATION §6): защита общего
# дневного LLM-бюджета тенанта (ERR-AI-002) от одного болтливого/злонамеренного
# чата. Две ступени на chat_id: всплеск (N сообщений за окно, сек) и дневной
# потолок (UTC-сутки). Превышение — вежливый отказ без вызова LLM
# (ERR-CHANNEL-003). Значение ≤0 отключает ступень. Счётчики — в Redis;
# при его недоступности лимит fail-open (диалог важнее защиты от перерасхода).
GUEST_CHAT_RATE_LIMIT_MESSAGES=20
GUEST_CHAT_RATE_LIMIT_WINDOW_SECONDS=600
GUEST_CHAT_RATE_LIMIT_MESSAGES_PER_DAY=200

# Лимит попыток ввода кода заселения в веб-чате (spec 0027 §3.3, ADR-008):
# ключ — (tenant, room), перебор кода соседа с многих устройств не обходит
# лимит. Превышение — 429 ERR-WEB-004. Значение ≤0 отключает.
GUEST_CODE_VERIFY_RATE_LIMIT_ATTEMPTS=10
GUEST_CODE_VERIFY_RATE_LIMIT_WINDOW_SECONDS=600

# Rate-limit'ы одноразовой QR-ссылки привязки (spec 0033 §6/§9, канон 0023):
# выпуск — кабинет по (tenant, stay), 429 ERR-AUTH-010; потребление — канал web
# по IP, 429 ERR-WEB-005 (лимит просторный: гости за NAT отеля делят адрес).
# Значение ≤0 отключает.
GUEST_BIND_LINK_ISSUE_RATE_LIMIT_ATTEMPTS=30
GUEST_BIND_LINK_ISSUE_RATE_LIMIT_WINDOW_SECONDS=600
GUEST_BIND_LINK_CONSUME_RATE_LIMIT_ATTEMPTS=60
GUEST_BIND_LINK_CONSUME_RATE_LIMIT_WINDOW_SECONDS=600

# Кабинет персонала (spec 0033 §3.3, ADR-008 §1). Сессии живут на личных
# телефонах персонала: idle-срок продлевается активностью, absolute — жёсткий
# предел; отзыв — деактивацией пользователя, не TTL. Rate-limit логина считается
# по email И по IP (превышение — 429 ERR-AUTH-006), и тратят его только НЕУДАЧНЫЕ
# попытки (issue #207); бюджеты разные, потому что за email стоит один человек,
# а за IP — весь отель за общим NAT. Ссылка-приглашение живёт
# STAFF_INVITE_TTL_HOURS часов. Значение лимита ≤0 отключает свой ключ.
STAFF_SESSION_IDLE_TTL_DAYS=30
STAFF_SESSION_ABSOLUTE_TTL_DAYS=180
STAFF_INVITE_TTL_HOURS=72
STAFF_LOGIN_RATE_LIMIT_ATTEMPTS=10
STAFF_LOGIN_IP_RATE_LIMIT_ATTEMPTS=60
STAFF_LOGIN_RATE_LIMIT_WINDOW_SECONDS=600

# Доверенные прокси (issue #207): IP/CIDR через запятую, чьему заголовку
# CF-Connecting-IP приложение верит как адресу клиента. ПУСТО (дефолт) — верить
# только адресу сокета; так и надо локально, где приложение открыто напрямую.
# На staging/проде за Cloudflare-туннелем сюда идёт подсеть docker-сети
# (ops/deploy/docker-compose.staging.yml). Опечатка в CIDR роняет старт намеренно.
TRUSTED_PROXY_IPS=

# Канал Telegram (Task 0016, FOUNDATION §8.4). TELEGRAM_WEBHOOK_SECRET — секрет
# вебхука: Telegram шлёт его в заголовке X-Telegram-Bot-Api-Secret-Token (задаётся
# при setWebhook); ПУСТОЙ = вебхук закрыт и отвергает всё (fail-closed). Локальный
# дефолт dev-webhook-secret открывает вебхук для smoke-набора (make smoke,
# Task 0019) — тот же паттерн, что SERVICE_TOKEN=dev-service-token; на staging
# секрет обязан быть случайным. Регистрация вебхука и генерация секрета —
# docs/runbooks/telegram.md. TELEGRAM_BOT_TOKEN —
# токен бота от BotFather для отправки ответов. TELEGRAM_TENANT_SLUG — какому
# тенанту принадлежит чат (Phase 0: один бот = демо-тенант). TELEGRAM_STAFF_CHAT_ID
# (Task 0017) — chat.id ДЕФОЛТНОГО staff-чата: туда идут уведомления о новых
# заявках, там персонал закрывает их командами /assign|/start|/done|/cancel <id>.
# ПУСТОЙ = уведомления службе выключены (на staging для сквозного скелета —
# обязателен). Чаты отдельных служб (категория заявки → свой чат, spec 0026) —
# не здесь, а в конфиге тенанта: `python -m hospitality.tools.staff_routing`,
# см. docs/runbooks/telegram.md шаг 2б.
TELEGRAM_WEBHOOK_SECRET=dev-webhook-secret
TELEGRAM_BOT_TOKEN=
TELEGRAM_TENANT_SLUG=demo-hotel
TELEGRAM_STAFF_CHAT_ID=

# Наблюдаемость (Task 0018, FOUNDATION §10.4, §10.7, §10.8). SENTRY_DSN — DSN
# проекта Sentry; ПУСТОЙ = Sentry выключен (локально и в CI так и нужно).
# SENTRY_ENVIRONMENT разделяет события dev/staging в одном проекте Sentry и
# служит префиксом [dev]/[staging] в тексте алертов. TELEGRAM_ALERT_* — бот и
# chat.id Telegram-канала команды: их читает и алертер (hospitality.tools.alerter),
# и воркер — он докладывает о событиях в dead-letter (issue #133). Локально не
# нужны: пустая пара переводит оба в пассивный режим.
# Пороги и период опроса алертера названы блоком ниже; адрес приложения
# (ALERT_TARGET_BASE_URL) и ссылка на runbook в тексте алерта
# (ALERT_RUNBOOK_URL) имеют умолчания в Settings — их задаёт compose, руками
# трогать нечего.
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# Ручки самого алертера. Период опроса — как часто он ходит в /health/ready и
# /metrics. ALERT_READY_FAILURE_THRESHOLD — сколько неудач подряд считать
# падением приложения (ERR-OPS-001): одиночный чих алертом не становится.
# ALERT_ERROR_SPIKE_THRESHOLD — прирост ответов 5xx за опрос, который считается
# всплеском (ERR-OPS-002), ALERT_COOLDOWN_SECONDS — молчание после такого алерта,
# чтобы всплеск не превратился в ленту сообщений.
ALERT_POLL_INTERVAL_SECONDS=60.0
ALERT_READY_FAILURE_THRESHOLD=2
ALERT_ERROR_SPIKE_THRESHOLD=5
ALERT_COOLDOWN_SECONDS=900.0

# Пороги двух линий алерта «доставка событий встала» (issue #136), их читает
# тот же алертер. Первая: пульс воркера (метрика worker_heartbeat_age_seconds)
# старше ALERT_WORKER_HEARTBEAT_MAX_AGE_SECONDS → ERR-OPS-003 — процесс мёртв или
# завис. Вторая: очередь (outbox_pending_events) выше ALERT_OUTBOX_DEPTH_THRESHOLD
# → ERR-OPS-004 — цикл жив, но не разбирает очередь.
ALERT_WORKER_HEARTBEAT_MAX_AGE_SECONDS=300.0
ALERT_OUTBOX_DEPTH_THRESHOLD=100

# Доля дневного LLM-бюджета тенанта, на которой алертер предупреждает
# (ERR-OPS-006, issue #103): расход и лимит он берёт из метрик
# llm_daily_spend_usd / llm_daily_budget_usd. 0.8 оставляет примерно пятую часть
# суток на реакцию — поднять LLM_TENANT_DAILY_BUDGET_USD или разобраться,
# почему жжётся; на 100% вызовы отвергаются (ERR-AI-002) и бот замолкает.
# Значение ≤0 или ≥1 отключает эту линию.
ALERT_LLM_BUDGET_RATIO=0.8

# Уровень логирования приложения (Task 0007): DEBUG | INFO | WARNING | ERROR.
# ВНИМАНИЕ: WARNING и выше отключает событие http_request (уровень INFO) —
# поиск следа запроса по correlation id в логах перестанет находить записи.
LOG_LEVEL=INFO

# Воркер доменных событий (Task 0010, ADR-005): период опроса outbox при
# пустой очереди (сек), размер пачки за итерацию, предел попыток доставки
# одного события (исчерпание — ERR-EVENTS-002 в docs/runbooks/errors.md).
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_BATCH_SIZE=50
WORKER_MAX_DELIVERY_ATTEMPTS=10

# Backoff между попытками доставки одного события (issue #18, ADR-009):
# после неудачи следующая попытка — не раньше, чем через
# min(WORKER_RETRY_BACKOFF_BASE_SECONDS * 2**(attempts-1), WORKER_RETRY_BACKOFF_MAX_SECONDS).
WORKER_RETRY_BACKOFF_BASE_SECONDS=2.0
WORKER_RETRY_BACKOFF_MAX_SECONDS=300.0

# Аренда строки outbox на время доставки (issue #134, ADR-016): сетевые вызовы
# идут вне транзакции, и взятое в работу событие держит эта отметка. Столько же
# ждёт возврата в очередь событие, чей воркер умер посреди доставки.
WORKER_DELIVERY_LEASE_SECONDS=300.0

# Retention завершённых строк outbox_events (issue #18, ADR-009; issue #133,
# ADR-015; FOUNDATION §9): сколько дней хранить доставленные (processed_at) и
# похороненные (dead_lettered_at — повторы исчерпаны) строки и как часто воркер
# проверяет, не пора ли их удалить.
OUTBOX_RETENTION_DAYS=30
WORKER_CLEANUP_INTERVAL_SECONDS=3600.0

# Как часто воркер докладывает в канал команды о событиях, ушедших в dead-letter
# (issue #133, ERR-EVENTS-002). Адресат — та же пара TELEGRAM_ALERT_*, что у
# алертера; пустая пара = шаг выключен. Повторов не будет и при частой проверке:
# о каждом событии рассказывают ровно один раз (dead_letter_alerted_at).
WORKER_DEAD_LETTER_ALERT_INTERVAL_SECONDS=60.0

# Как часто воркер отмечает пульс — «круг цикла состоялся» (issue #136).
# По возрасту этой отметки алертер снаружи видит мёртвый воркер (ERR-OPS-003);
# сам о своей смерти процесс доложить не может. Не каждый круг: при периоде
# опроса 1 с это была бы запись в БД каждую секунду.
WORKER_HEARTBEAT_INTERVAL_SECONDS=30.0

# Ретеншн гостевых текстов (issue #42, spec 0032): сколько дней живут тексты
# сообщений (потом строки удаляются, опустевшие диалоги — тоже) и свободный
# текст заявок (потом обезличивается), и как часто воркер это проверяет.
# 90 дней — обещание политики конфиденциальности (docs/legal/privacy-policy.md
# п. 7): менять только вместе с опубликованным текстом.
MESSAGES_RETENTION_DAYS=90
WORKER_RETENTION_INTERVAL_SECONDS=3600.0

# Напоминания о невзятых заявках (issue #57, spec 0028): как часто воркер ищет
# заявки, которые никто не взял дольше срока тенанта. Сам срок — конфиг тенанта
# (`python -m hospitality.tools.request_reminders`), не окружение (P-11).
WORKER_REMINDER_INTERVAL_SECONDS=300.0

# Доступ к staging с машины основателя (Task 0019): адрес и SSH-ключ для
# make smoke-staging / make backup-fetch. Значения задаются только в локальном
# .env — адрес сервера и пути ключей в репозитории не хранятся (§11).
STAGING_HOST=
STAGING_SSH_KEY=
# Внешний адрес приложения staging для smoke: после Cloudflare-туннеля (ADR-012,
# PR #70) порт 8000 наружу закрыт, ходить нужно через https://staging.necturn.com.
# Пусто = старый прямой адрес http://$STAGING_HOST:8000.
STAGING_BASE_URL=
# ПРИВАТНЫЙ ключ age, которым расшифровываются бэкапы БД (issue #81, spec 0024).
# Живёт ТОЛЬКО на машине основателя (плюс копия в менеджере паролей — потеря
# ключа = потеря всех бэкапов). make backup-fetch проверяет им скачанный дамп,
# restore.md — расшифровывает при восстановлении. Пусто = путь по умолчанию
# ~/.config/age/hospitality-backup.key; в репозитории ключей нет (§11).
BACKUP_AGE_KEY=
